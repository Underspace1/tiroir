{
  "name": "tiroir",
  "version": "1.0.0",
  "description": "Client de bureau pour Google Drive, Gmail, Agenda et Tâches, avec Gemini intégré",
  "main": "app/main.js",
  "scripts": {
    "start": "electron .",
    "web": "node server.js",
    "test": "node --test --test-force-exit test/api.test.js",
    "dist": "electron-builder --win nsis portable"
  },
  "build": {
    "appId": "app.tiroir.desktop",
    "productName": "Tiroir",
    "directories": {
      "output": "dist"
    },
    "files": [
      "app/**",
      "web/**",
      "server.js",
      "services.js",
      "package.json",
      "node_modules/@fontsource-variable/archivo/**",
      "node_modules/@fontsource/ibm-plex-mono/**",
      "node_modules/lucide/**"
    ],
    "win": {
      "icon": "web/icon-256.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Tiroir",
      "artifactName": "Tiroir-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Tiroir-Portable-${version}.${ext}"
    }
  },
  "author": "Underspace",
  "homepage": "https://github.com/Underspace1/tiroir#readme",
  "repository": { "type": "git", "url": "https://github.com/Underspace1/tiroir.git" },
  "license": "GPL-3.0-only",
  "type": "commonjs",
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "lucide": "^1.73.0"
  },
  "productName": "Tiroir",
  "devDependencies": {
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0"
  }
}
